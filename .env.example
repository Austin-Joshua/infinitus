# INFINITUS Mathematics Club — Environment Configuration
# All variables are optional. Without environment variables, the site runs
# 100% on the bundled static data in lib/data.js with zero external dependencies.

# Canonical Production URL (used for sitemap, robots, OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://infinitus-seven.vercel.app

# Supabase (Optional Database Integration)
# In Vercel, set ONLY SUPABASE_URL and SUPABASE_ANON_KEY.
# DO NOT set SUPABASE_SERVICE_ROLE_KEY in Vercel or any client environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY is used exclusively for one-time offline database seeding:
# `npm run db:seed`. Never commit, expose, or deploy this key.
# SUPABASE_SERVICE_ROLE_KEY=
